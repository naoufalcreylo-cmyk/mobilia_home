{%- comment -%}
  Visible breadcrumb + BreadcrumbList schema. Params: product (optional), collection (optional)
  For products, the parent is the first collection that appears in the main menu (keeps URLs canonical: /products/handle).
{%- endcomment -%}
{%- liquid
  assign parent = collection
  if product and parent == blank
    for link in linklists[settings.main_menu].links
      for child in link.links
        for grand in child.links
          if grand.type == 'collection_link' and product.collections contains grand.object
            assign parent = grand.object
            break
          endif
        endfor
        if parent
          break
        endif
        if child.type == 'collection_link' and product.collections contains child.object
          assign parent = child.object
          break
        endif
      endfor
      if parent
        break
      endif
    endfor
    if parent == blank
      assign parent = product.collections.first
    endif
  endif
-%}
<ol class="crumbs" role="list" aria-label="{{ 'accessibility.breadcrumb' | t }}">
  <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
  {%- if parent and product -%}<li><a href="{{ parent.url }}">{{ parent.title }}</a></li>{%- endif -%}
  {%- if product -%}
    <li><span aria-current="page">{{ product.title | split: ' – ' | first | split: ' - ' | first }}</span></li>
  {%- elsif parent -%}
    <li><span aria-current="page">{{ parent.title }}</span></li>
  {%- endif -%}
</ol>
<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ shop.url | json }} }
    {%- if parent -%},{ "@type": "ListItem", "position": 2, "name": {{ parent.title | json }}, "item": {{ shop.url | append: parent.url | json }} }{%- endif -%}
    {%- if product -%},{ "@type": "ListItem", "position": {% if parent %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }{%- endif -%}
  ]
}
</script>
