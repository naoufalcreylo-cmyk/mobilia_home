/* Self-hosted, latin subset (SIL Open Font License). Swapped in to avoid invisible text. */
@font-face { font-family: "Instrument Serif"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ 'InstrumentSerif-normal.woff2' | asset_url }}") format("woff2"); }
@font-face { font-family: "Instrument Serif"; font-style: italic; font-weight: 400; font-display: swap; src: url("{{ 'InstrumentSerif-italic.woff2' | asset_url }}") format("woff2"); }
@font-face { font-family: "Manrope"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("{{ 'Manrope-normal.woff2' | asset_url }}") format("woff2"); }
