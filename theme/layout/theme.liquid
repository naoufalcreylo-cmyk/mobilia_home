<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#FAF8F4">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  {%- endif -%}

  {%- capture seo_title -%}
    {{ page_title }}
    {%- if current_tags %} – {{ 'general.tagged_with' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
  {%- endcapture -%}
  <title>{{ seo_title | strip }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {{ 'Manrope-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'InstrumentSerif-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'fonts.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'index' or template.name == 'page' or template.name == 'product' -%}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template.name == 'collection' or template.name == 'search' or template.name == 'product' or template.name == 'cart' or template.name == '404' -%}
    {{ 'templates.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  <script>
    document.documentElement.classList.remove('no-js');
    window.Mobilia = {
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      },
      whatsapp: {{ settings.whatsapp_number | remove: ' ' | remove: '+' | json }},
      shopUrl: {{ shop.url | json }},
      currency: {{ cart.currency.iso_code | json }},
      moneyFormat: {{ shop.money_format | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 }},
      strings: {
        addedToWishlist: {{ 'wishlist.added' | t | json }},
        removedFromWishlist: {{ 'wishlist.removed' | t | json }},
        cartError: {{ 'cart.error' | t | json }}
      }
    };
  </script>
  <script src="{{ 'analytics.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'cart.js' | asset_url }}" defer></script>
  <script src="{{ 'search.js' | asset_url }}" defer></script>

  {{ content_for_header }}

  {% render 'schema-organization' %}
</head>

<body class="has-header template-{{ template.name }}">
  <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>
  {% render 'icon-sprite' %}

  {% sections 'header-group' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'predictive-search' %}
  {% section 'cart-drawer' %}
  {% render 'quick-view' %}

  {%- if settings.show_help_button and template.name != 'product' -%}
    <aside aria-label="{{ 'help.label' | t }}">
      <a class="help-fab is-hidden" data-help-fab href="{% render 'whatsapp-url', message: settings.help_message %}" target="_blank" rel="noopener" aria-label="{{ 'help.button' | t }}" data-wa-context="help">
        {% render 'icon', name: 'whatsapp', class: 'wa-icon' %}<span>{{ 'help.short' | t }}</span>
      </a>
    </aside>
  {%- endif -%}
  <div class="toast" role="status" aria-live="polite" data-toast></div>
</body>
</html>
