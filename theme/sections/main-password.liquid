<div class="error-state">
  <div>
    {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 320 | image_tag: alt: shop.name, style: 'margin:0 auto 2rem;width:160px;height:auto' }}{%- else -%}<img src="{{ 'logo-mobilia.png' | asset_url }}" alt="{{ shop.name }}" width="160" height="63" style="margin:0 auto 2rem;width:160px;height:auto">{%- endif -%}
    <h1 class="h2">{{ section.settings.title }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'footer__form', style: 'margin:2rem auto 0' -%}
      <label class="visually-hidden" for="pw">Mot de passe</label>
      <input class="input" id="pw" type="password" name="password" autocomplete="current-password" placeholder="Mot de passe">
      <button class="btn" type="submit">Entrer</button>
      {%- if form.errors -%}<p role="alert" style="color:var(--sale)">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Mot de passe", "settings": [{ "type": "text", "id": "title", "label": "Titre", "default": "Notre nouvelle boutique arrive bientôt." }] }
{% endschema %}
