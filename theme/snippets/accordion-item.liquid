{%- comment -%} Accessible accordion item. Params: prefix (unique per section), id, title, content (HTML), open (bool), level (default 2) {%- endcomment -%}
{%- assign uid = 'acc-' | append: prefix | append: '-' | append: id -%}
{%- assign lvl = level | default: 2 -%}
<div class="acc__item{% if open %} is-open{% endif %}">
  <h{{ lvl }} style="margin:0"><button class="acc__btn" type="button" aria-expanded="{% if open %}true{% else %}false{% endif %}" aria-controls="{{ uid }}" id="{{ uid }}-b">{{ title }}<span class="plus" aria-hidden="true"></span></button></h{{ lvl }}>
  <div class="acc__panel" id="{{ uid }}" role="region" aria-labelledby="{{ uid }}-b"{% unless open %} inert{% endunless %}><div><div class="acc__content prose">{{ content }}</div></div></div>
</div>
