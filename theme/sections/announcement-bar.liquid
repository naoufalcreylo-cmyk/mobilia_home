{%- comment -%}
  Rotating announcement bar. Token {max_discount} is replaced by the deepest real discount of the chosen
  collection (available products only), so promotional claims always match live prices.
{%- endcomment -%}
{%- liquid
  assign max_off = 0
  if section.settings.discount_collection != blank
    for p in section.settings.discount_collection.products limit: 250
      assign v = p.selected_or_first_available_variant
      if p.available and v.compare_at_price > v.price
        assign off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
        if off > max_off
          assign max_off = off
        endif
      endif
    endfor
  endif
-%}
{%- if section.blocks.size > 0 -%}
<div class="announce" role="region" aria-label="{{ 'announcement.label' | t }}">
  <div class="container announce__inner">
    {%- if section.blocks.size > 1 -%}<button class="announce__nav" type="button" data-ann="-1" aria-label="{{ 'announcement.previous' | t }}">{% render 'icon', name: 'chev-l' %}</button>{%- endif -%}
    <div class="announce__track" aria-live="polite">
      {%- assign shown = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text contains '{max_discount}' and max_off < 10 -%}{%- continue -%}{%- endif -%}
        {%- assign txt = block.settings.text | replace: '{max_discount}', max_off -%}
        <p class="announce__msg{% if shown == 0 %} is-active{% endif %}"{% if shown > 0 %} aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if shown > 0 %} tabindex="-1"{% endif %}>{{ txt }}</a>{%- else -%}<span>{{ txt }}</span>{%- endif -%}
        </p>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}<button class="announce__nav" type="button" data-ann="1" aria-label="{{ 'announcement.next' | t }}">{% render 'icon', name: 'chev-r' %}</button>{%- endif -%}
    <div class="announce__side">
      {%- if section.settings.side_link != blank -%}<a href="{{ section.settings.side_link }}">{{ section.settings.side_label }}</a>{%- endif -%}
      {%- if settings.phone_display != blank -%}<a href="tel:{{ settings.phone_e164 }}">{{ settings.phone_display }}</a>{%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Barre d’annonce",
  "class": "section-announcement",
  "settings": [
    { "type": "collection", "id": "discount_collection", "label": "Collection pour le jeton {max_discount}", "info": "La remise maximale réelle de cette collection remplace {max_discount}. Le message est masqué si elle est inférieure à 10 %." },
    { "type": "text", "id": "side_label", "label": "Lien latéral — texte", "default": "Nos magasins" },
    { "type": "url", "id": "side_link", "label": "Lien latéral — URL" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "limit": 6, "settings": [
      { "type": "inline_richtext", "id": "text", "label": "Texte", "default": "Livraison express <strong>sous 48h</strong>, partout au Maroc" },
      { "type": "url", "id": "link", "label": "Lien" }
    ] }
  ],
  "presets": [{ "name": "Barre d’annonce" }]
}
{% endschema %}
