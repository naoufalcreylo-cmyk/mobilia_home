<footer class="footer on-dark" id="contact">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'lazy', style: 'width:150px;height:auto' }}{%- else -%}<img src="{{ 'logo-mobilia.png' | asset_url }}" alt="{{ shop.name }}" width="150" height="59" loading="lazy">{%- endif -%}
        {%- if section.settings.brand_text != blank -%}<p>{{ section.settings.brand_text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_newsletter -%}
        <div class="footer__news">
          <h2 class="h3">{{ section.settings.newsletter_heading }}</h2>
          <p>{{ section.settings.newsletter_text }}</p>
          {%- form 'customer', id: 'footer-newsletter', class: 'footer__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="nl-email">{{ 'newsletter.email' | t }}</label>
            <input class="input" id="nl-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
            <button class="btn btn--light" type="submit">{{ 'newsletter.subscribe' | t }}</button>
          {%- endform -%}
          {%- comment -%} Filled by theme.js when Shopify redirects with ?customer_posted=true {%- endcomment -%}
          <p class="footer__form-msg" role="status" data-newsletter-msg data-success="{{ 'newsletter.success' | t | escape }}"></p>
        </div>
      {%- endif -%}
    </div>

    <div class="footer__cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="label">{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h3>
              <ul role="list">{%- for link in linklists[block.settings.menu].links -%}<li><a class="link-u" href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
            </div>
          {%- when 'contact' -%}
            <div class="footer__contact" {{ block.shopify_attributes }}>
              <h3 class="label">{{ block.settings.heading }}</h3>
              <ul role="list">
                {%- if settings.phone_display != blank -%}<li><span>{{ 'footer.customer_service' | t }}</span><a href="tel:{{ settings.phone_e164 }}">{{ settings.phone_display }}</a></li>{%- endif -%}
                {%- if settings.whatsapp_number != blank -%}<li><span>WhatsApp</span><a href="{% render 'whatsapp-url', message: settings.help_message %}" target="_blank" rel="noopener" data-wa-context="footer">{{ settings.whatsapp_display | default: settings.whatsapp_number }}</a></li>{%- endif -%}
                {%- if settings.contact_email != blank -%}<li><span>E-mail</span><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>{%- endif -%}
              </ul>
              <div class="footer__social">
                {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
                {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
      <div class="footer__legal">{%- for link in linklists[section.settings.legal_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div>
      <div class="footer__pay" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'footer__pay-icon' }}{%- endfor -%}
        {%- assign extra = section.settings.extra_payments | split: ',' -%}
        {%- for e in extra -%}<span>{{ e | strip }}</span>{%- endfor -%}
      </div>
    </div>
  </div>
  {%- if section.settings.show_wordmark -%}<div class="footer__wordmark" aria-hidden="true" data-text="{{ shop.name }}"></div>{%- endif -%}
</footer>
<style>.footer__pay-icon { height: 28px; width: auto; border-radius: 2px; }</style>
{% schema %}
{
  "name": "Pied de page",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "brand_text", "label": "Texte de marque", "default": "Depuis 30 ans, Mobilia Home meuble les intérieurs marocains : salons, salles à manger, chambres et rangements, au prix d’usine, livrés et montés chez vous." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Afficher la newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Titre newsletter", "default": "Rejoignez la famille Mobilia." },
    { "type": "text", "id": "newsletter_text", "label": "Texte newsletter", "default": "Promotions, nouveaux produits et soldes, directement dans votre boîte de réception." },
    { "type": "link_list", "id": "legal_menu", "label": "Menu légal", "default": "footer" },
    { "type": "text", "id": "extra_payments", "label": "Autres moyens de paiement (séparés par des virgules)", "default": "Virement, En magasin" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Afficher le grand logotype typographique", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Colonne de liens", "limit": 5, "settings": [
      { "type": "text", "id": "heading", "label": "Titre" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ] },
    { "type": "contact", "name": "Contact & réseaux", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Nous contacter" }
    ] }
  ]
}
{% endschema %}
