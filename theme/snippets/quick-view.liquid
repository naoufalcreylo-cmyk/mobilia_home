<div class="modal" id="quick" aria-hidden="true" data-quick-modal>
  <div class="modal__overlay" data-close></div>
  <div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="qv-title">
    <button class="icon-btn modal__close" type="button" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <div data-qv style="display:contents"></div>
  </div>
</div>
