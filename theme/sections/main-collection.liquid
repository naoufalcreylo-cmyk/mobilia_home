{%- comment -%}
  Collection page (PLP). Section-rendered by assets/facets.js on filter/sort/load-more, so every
  dynamic region carries a data-* hook: [data-plp-count] [data-active-filters] [data-plp-grid]
  [data-filters] [data-plp-more].
  Dark editorial header when the collection uses the template suffix "outlet".
{%- endcomment -%}
{%- liquid
  assign dark = false
  if collection.template_suffix == 'outlet'
    assign dark = true
  endif
  comment
    Sub-navigation: siblings of this collection inside the main menu (keeps the catalogue browsable
    sideways: Salon d’angle ↔ Salon en U ↔ Salon marocain…)
  endcomment
  assign siblings = nil
  assign parent_label = ''
  for link in linklists[settings.main_menu].links
    for child in link.links
      for grand in child.links
        if grand.type == 'collection_link' and grand.object.id == collection.id
          assign siblings = child.links
          assign parent_label = link.title
        endif
      endfor
      if child.type == 'collection_link' and child.object.id == collection.id and child.links.size == 0
        assign siblings = link.links
        assign parent_label = link.title
      endif
    endfor
  endfor
  assign eyebrow = section.settings.eyebrow | default: parent_label
-%}
{%- paginate collection.products by section.settings.per_page -%}
<header class="plp-head{% if dark %} plp-head--dark on-dark{% endif %}{% unless collection.image and section.settings.show_image %} plp-head--noimg{% endunless %}">
  <div class="container">
    {% render 'breadcrumbs', collection: collection %}
    <div class="plp-head__grid">
      <div class="plp-head__copy">
        {%- if eyebrow != blank -%}<p class="label" style="color:{% if dark %}var(--saffron){% else %}var(--taupe){% endif %};margin-bottom:1rem">{{ eyebrow }}</p>{%- endif -%}
        <h1 class="h1 plp-head__title">{{ collection.title }}<sup data-plp-count-sup>{{ collection.products_count }}</sup></h1>
        {%- if collection.description != blank -%}<div class="plp-head__desc body-l rte">{{ collection.description }}</div>{%- endif -%}
      </div>
      {%- if collection.image and section.settings.show_image -%}
        <div class="plp-head__media media">{% render 'image', image: collection.image, sizes: '33vw', max: 960, eager: true, alt: '' %}</div>
      {%- endif -%}
    </div>
    {%- if siblings -%}
      <nav class="subnav" aria-label="{{ 'collections.subnav' | t }}"><div class="scroller">
        {%- for s in siblings -%}
          {%- assign current = false -%}{%- if s.type == 'collection_link' and s.object.id == collection.id -%}{%- assign current = true -%}{%- endif -%}
          <a class="chip{% if current %} is-active{% endif %}" href="{{ s.url }}"{% if current %} aria-current="page"{% endif %}>{{ s.title }}{% if s.type == 'collection_link' %} <span class="muted small">{{ s.object.all_products_count }}</span>{% endif %}</a>
        {%- endfor -%}
      </div></nav>
    {%- endif -%}
  </div>
</header>

<div class="toolbar"><div class="container toolbar__inner">
  <button class="toolbar__filter" type="button" data-filters-toggle aria-controls="filters" aria-expanded="true">{% render 'icon', name: 'filter' %}<span data-filter-label>{{ 'facets.title' | t }}</span>
    {%- liquid
      assign active_count = 0
      for f in collection.filters
        assign active_count = active_count | plus: f.active_values.size
        if f.type == 'price_range'
          if f.min_value.value != nil or f.max_value.value != nil
            assign active_count = active_count | plus: 1
          endif
        endif
      endfor
    -%}
    <span class="count" data-count="{{ active_count }}">{% if active_count > 0 %}{{ active_count }}{% endif %}</span></button>
  <span class="toolbar__count" data-plp-count aria-live="polite">{{ 'collections.count' | t: count: collection.products_count }}</span>
  <div class="toolbar__sort"><label for="sort">{{ 'collections.sort_by' | t }}</label>
    <select id="sort" name="sort_by" data-sort>
      {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
      {%- for o in collection.sort_options -%}<option value="{{ o.value }}"{% if o.value == current_sort %} selected{% endif %}>{{ o.name }}</option>{%- endfor -%}
    </select>
  </div>
  <div class="toolbar__density" role="group" aria-label="{{ 'collections.density' | t }}">
    <button type="button" data-density="2" aria-pressed="false" aria-label="{{ 'collections.large_tiles' | t }}">{% render 'icon', name: 'grid2' %}</button>
    <button type="button" data-density="4" aria-pressed="true" aria-label="{{ 'collections.standard_tiles' | t }}">{% render 'icon', name: 'grid4' %}</button>
  </div>
</div></div>

<div class="container" data-plp data-section-id="{{ section.id }}">
  <div class="active-filters" data-active-filters>
    {%- for f in collection.filters -%}
      {%- for v in f.active_values -%}<a class="chip" href="{{ v.url_to_remove }}" data-facet-link aria-label="{{ 'facets.remove' | t: name: v.label | escape }}">{{ v.label }} {% render 'icon', name: 'close' %}</a>{%- endfor -%}
      {%- if f.type == 'price_range' -%}
        {%- if f.min_value.value != nil or f.max_value.value != nil -%}
          <a class="chip" href="{{ f.url_to_remove }}" data-facet-link>{{ f.min_value.value | default: 0 | money }} – {{ f.max_value.value | default: f.range_max | money }} {% render 'icon', name: 'close' %}</a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if active_count > 0 -%}<a class="clear" href="{{ collection.url }}?sort_by={{ current_sort }}" data-facet-link>{{ 'facets.clear_all' | t }}</a>{%- endif -%}
  </div>

  <div class="plp" data-density="4">
    {% render 'facets', results: collection %}
    <div>
      <h2 class="visually-hidden">{{ 'collections.products' | t }}</h2>
      <div class="product-grid" data-plp-grid data-list="{{ collection.title | escape }}">
        {%- for product in collection.products -%}
          {%- if forloop.index == 9 and section.settings.show_tile and paginate.current_page == 1 and collection.products_count >= 12 -%}
            <aside class="grid-tile on-dark">
              <div><span class="label">{{ section.settings.tile_eyebrow }}</span><p class="h2">{{ section.settings.tile_title }}</p><p>{{ section.settings.tile_text }}</p></div>
              {%- assign tile_msg = 'collections.tile_message' | t: name: collection.title -%}
              <a class="btn btn--light" href="{% render 'whatsapp-url', message: tile_msg %}" target="_blank" rel="noopener" data-wa-context="plp_tile">{% render 'icon', name: 'whatsapp' %}{{ section.settings.tile_cta }}</a>
            </aside>
          {%- endif -%}
          {%- if forloop.index <= 4 and paginate.current_page == 1 -%}{%- assign eager = true -%}{%- else -%}{%- assign eager = false -%}{%- endif -%}
          {% render 'product-card', product: product, eager: eager, list: collection.title, sizes: '(min-width:1280px) 22vw, (min-width:1024px) 28vw, (min-width:768px) 33vw, 50vw' %}
        {%- else -%}
          <div class="empty-state" style="grid-column:1/-1">
            <div class="empty-state__mark">{% render 'icon', name: 'filter' %}</div>
            {%- if active_count > 0 -%}
              <p class="h3">{{ 'facets.no_results_title' | t }}</p><p>{{ 'facets.no_results_text' | t }}</p>
              <a class="btn" href="{{ collection.url }}" data-facet-link>{{ 'facets.clear' | t }}</a>
            {%- else -%}
              <p class="h3">{{ 'collections.empty_title' | t }}</p><p>{{ 'collections.empty_text' | t }}</p>
              <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'collections.browse_all' | t }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="plp-more" data-plp-more{% unless paginate.next %} hidden{% endunless %}>
        {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
        <div class="plp-more__meter"><span style="width: {{ shown | times: 100 | divided_by: paginate.items }}%"></span></div>
        <p>{{ 'collections.progress' | t: shown: shown, total: paginate.items }}</p>
        {%- if paginate.next -%}<a class="btn btn--ghost" href="{{ paginate.next.url }}" data-load-more>{{ 'collections.load_more' | t }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endpaginate -%}
<script src="{{ 'facets.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre (sinon rubrique du menu)" },
    { "type": "checkbox", "id": "show_image", "label": "Afficher l’image de la collection", "default": true },
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 12, "max": 48, "step": 12, "default": 24 },
    { "type": "header", "content": "Tuile conseil (après 8 produits)" },
    { "type": "checkbox", "id": "show_tile", "label": "Afficher", "default": true },
    { "type": "text", "id": "tile_eyebrow", "label": "Surtitre", "default": "Besoin d’aide pour choisir ?" },
    { "type": "text", "id": "tile_title", "label": "Titre", "default": "Un conseiller vous répond sur WhatsApp." },
    { "type": "textarea", "id": "tile_text", "label": "Texte", "default": "Dimensions, coloris, sur-mesure, délais : envoyez-nous votre question ou la photo de votre pièce." },
    { "type": "text", "id": "tile_cta", "label": "Bouton", "default": "Demander conseil" }
  ]
}
{% endschema %}
